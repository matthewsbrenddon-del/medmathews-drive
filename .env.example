# ==============================================================================
# MedStudy Hub — variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha com suas credenciais reais.
# Sem estas variáveis, a aplicação roda automaticamente em MODO DEMONSTRAÇÃO,
# usando dados fictícios (ver src/lib/mockData.ts) em vez do Google Drive real.
# ==============================================================================

# --- Autenticação (NextAuth + Google OAuth) ---------------------------------
# Crie um projeto em https://console.cloud.google.com/apis/credentials
# Tipo de credencial: "OAuth client ID" > "Web application"
# Escopos necessários: openid, email, profile,
#   https://www.googleapis.com/auth/drive.readonly
#   https://www.googleapis.com/auth/drive.metadata.readonly
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# URL pública da aplicação (usada pelo NextAuth para montar o callback)
NEXTAUTH_URL="http://localhost:3000"
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Banco de dados (PostgreSQL via Prisma) ---------------------------------
# Ex.: postgresql://usuario:senha@localhost:5432/medstudy_hub
DATABASE_URL=""

# --- Google Drive API ---------------------------------------------------------
# Opcional: restringe a aplicação a uma pasta raiz específica do Drive.
GOOGLE_DRIVE_ROOT_FOLDER_ID=""
