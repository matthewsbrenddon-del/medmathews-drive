// ============================================================================
// MedStudy Hub v2 — schema de banco de dados (PostgreSQL)
//
// Modelo simplificado (spec v2, seção 5): não há mais integração OAuth com o
// Google Drive. Todo o conteúdo (aulas/materiais) e o banco de questões são
// importados por planilha .xlsx (ver src/lib/importCourses.ts e
// src/lib/importQuestions.ts). O identificador estável de um item de
// conteúdo é o `driveFileId` (nunca o título) — reimportar a planilha faz
// upsert por esse ID e nunca duplica registros.
//
// Nesta versão de demonstração a aplicação roda inteiramente client-side
// (localStorage via Zustand, ver src/lib/contentStore.ts e
// src/lib/questionStore.ts), sem exigir DATABASE_URL. Este schema documenta
// como a mesma forma de dado seria persistida em produção: defina
// DATABASE_URL e rode `npx prisma migrate dev`, e troque os stores client-side
// por chamadas às rotas de importação persistindo aqui (há um TODO em cada
// rota de import apontando onde plugar o Prisma).
//
// >>> PONTO DE EXTENSÃO FUTURO (não implementado agora) <<<
// Se um dia for necessário automatizar a leitura de pastas do Drive (em vez
// de depender da planilha), a integração OAuth completa da v1 pode ser
// restaurada: NextAuth + googleapis, varredura recursiva por pasta, e um
// job de sincronização que faz upsert em Content por driveFileId — o
// restante do schema (Question, UserProgress) não muda nada, e o app já
// resolve tudo por driveFileId/questionId, então plugar essa fonte alternativa
// de importação não exige tocar nas telas de estudo, apenas na tela de
// importação.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentKind {
  VIDEOAULA
  APOSTILA
  OUTRO
}

enum ItemType {
  CONTEUDO
  QUESTAO
}

enum WatchStatus {
  NAO_INICIADA
  EM_ANDAMENTO
  ASSISTIDA
}

enum ReadStatus {
  NAO_ACESSADO
  ACESSADO
  ESTUDADO
}

enum QuestionStatus {
  NAO_RESPONDIDA
  ACERTADA
  ERRADA
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  progress UserProgress[]
}

/// Um item de conteúdo (aula ou material) importado da planilha de cursos.
/// `driveFileId` é a chave estável — nunca o título, nunca o nome do arquivo.
model Content {
  id           String      @id @default(cuid())
  /// ID do arquivo no Google Drive, extraído do link de compartilhamento.
  driveFileId  String      @unique
  driveLink    String
  disciplina   String
  subjectSlug  String
  modulo       String?
  lessonNumber Int?
  titulo       String
  tema         String?
  kind         ContentKind
  durationMin  Int?
  ordem        Int?
  prioridade   Int         @default(3)
  observacoes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress UserProgress[]

  @@index([subjectSlug])
  @@index([kind])
}

/// Uma questão do banco de residência médica, importada por planilha.
model Question {
  id           String   @id @default(cuid())
  disciplina   String
  subjectSlug  String
  tema         String?
  banca        String?
  ano          Int?
  enunciado    String
  alternativaA String
  alternativaB String
  alternativaC String
  alternativaD String
  alternativaE String?
  gabarito     String
  comentario   String?
  dificuldade  Int      @default(3)
  tags         String[]
  observacoes  String?
  hasImage     Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress UserProgress[]

  @@index([subjectSlug])
  @@index([banca])
  @@index([ano])
}

/// Progresso do usuário — nunca perdido em uma reimportação, sempre
/// referenciado por ID (driveFileId do Content ou id da Question), nunca
/// por título/nome.
model UserProgress {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType ItemType

  contentId String?
  content   Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)
  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  watchStatus             WatchStatus?
  readStatus              ReadStatus?
  questionStatus          QuestionStatus?
  progressPercent         Int             @default(0)
  playbackPositionSeconds Int?
  favorite                Boolean         @default(false)
  lastViewedAt            DateTime?
  completedAt             DateTime?

  /// Histórico de respostas (para questões) — usado pela revisão espaçada
  /// simples (spec v2 seção 3): sai da fila de revisão após 2 acertos
  /// seguidos.
  correctStreak Int      @default(0)
  answerHistory Json?

  updatedAt DateTime @updatedAt

  @@unique([userId, contentId])
  @@unique([userId, questionId])
  @@index([userId])
}
